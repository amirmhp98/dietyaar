# Copy to .env and adjust. Every variable here is validated at boot by src/lib/env.ts.
# Product variables come from docs/tech-spec.md § 14.

# ─── App ─────────────────────────────────────────────────────────────────────
# Public origin. Used for the CSRF Origin check on mutating route handlers and CSP.
APP_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml (npm run db:up), published on
# host port 5433 so it does not collide with a local Postgres on 5432.
# VPS (decision 026): both are set by deploy/vps/docker-compose.yml to the Postgres
# container on the box. Vercel (decision 021): DATABASE_URL is the Supavisor
# transaction pooler (6543, ?pgbouncer=true), DIRECT_DATABASE_URL the session
# pooler (5432) for migrations and pg_dump.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app?schema=public"
# Optional locally (falls back to DATABASE_URL); required in production.
# DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Session lifetime in days (tech spec § 8: 90).
SESSION_MAX_AGE_DAYS=90
# Sign-ups per IP per hour.
SIGNUP_RATE_LIMIT=10
# "true" bypasses login and serves a mock admin, so the app runs without a
# database (UI work, component previews). Refused when NODE_ENV=production.
SKIP_AUTH=false

# ─── Logging ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# "true" logs every Prisma query (development only)
PRISMA_LOG_QUERIES=false

# ─── AI provider (DeepSeek) ──────────────────────────────────────────────────
# Leave empty locally to run without AI: analyses return AI_UNAVAILABLE and the
# manual paths still work. Required in production.
DEEPSEEK_API_KEY=
# Default: the real API, so meals logged locally are parsed by the real model.
# Offline alternative: http://localhost:3999 (e2e/stub-ai, started by `npm run dev:stub`); e2e always uses the stub.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
AI_MODEL_TEXT=deepseek-flash
AI_MODEL_VISION=deepseek-flash
# Global soft cap on completed tokens per UTC day; at 90% new operations get AI_UNAVAILABLE.
AI_DAILY_TOKEN_BUDGET=5000000

# ─── Feature flags (decision 015) ────────────────────────────────────────────
# Photo logging stays off until the vision evaluation passes (tech spec § 19.4).
PHOTO_LOGGING_ENABLED=false
USDA_LOOKUP_ENABLED=false
USDA_API_KEY=
# In-process scheduler (import jobs, cleanup, purge, prune, backup). Also true in e2e.
SCHEDULER_ENABLED=true
# Serverless hosts only (decision 021): the secret Vercel's cron sends to /api/cron/[task].
# Unset → the route answers 404. Set SCHEDULER_ENABLED=false alongside it.
# CRON_SECRET=

# ─── Photo storage: any S3 endpoint. All five or none. ───────────────────────
# Local values match the MinIO service in docker-compose.yml (`npm run storage:up`);
# CI uses the same with prefix `ci/`. The VPS stack sets all five to its own MinIO
# container inside deploy/vps/docker-compose.yml (decision 026); Vercel staging points
# at Supabase Storage's S3 endpoint with prefix `vercel/` (decision 021). Per-target
# values: docs/runbook.md "Environment variables by target".
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dietyaar-dev
S3_ACCESS_KEY_ID=dietyaar
S3_SECRET_ACCESS_KEY=dietyaar-dev-secret
# Key prefix inside the bucket, e.g. "dev/", "prod/" or "staging/".
S3_KEY_PREFIX=dev/
# Soft limit on the sum of attached upload bytes; uploads above it return STORAGE_FULL (700 MB).
STORAGE_SOFT_LIMIT_BYTES=734003200

# ─── Backups: Hamravesh Object Storage (required in production) ──────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENABLED=true
# Dumps older than this are deleted; the newest is always kept.
BACKUP_RETENTION_DAYS=30
# Passphrase for `openssl enc -aes-256-cbc -pbkdf2`; keep it outside the repo.
BACKUP_ENCRYPTION_KEY=

# ─── Tests (optional) ────────────────────────────────────────────────────────
# Credentials used by e2e/auth.setup.ts; defaults to the seeded demo user.
# TEST_USERNAME=demo
# TEST_PASSWORD=demo1234
