# Server-side environment for the VPS stack. Copy to /opt/dietyaar/.env and fill in.
# Compose reads this file twice: for `${VAR}` interpolation in docker-compose.yml
# (POSTGRES_PASSWORD, MINIO_*, DOMAIN, IMAGE) and as the app's env_file. Database
# and S3 variables are set by the compose file itself and do not belong here.

# ─── Stack ───────────────────────────────────────────────────────────────────
# CI rewrites this line on every deploy to the pushed tag.
IMAGE=ghcr.io/amirmhp98/dietyaar:latest
# Caddy obtains a certificate for this name; it must resolve to the server.
DOMAIN=85-198-48-114.sslip.io
POSTGRES_PASSWORD=
MINIO_ROOT_USER=dietyaar
MINIO_ROOT_PASSWORD=

# ─── App (same keys as the repo's .env.example) ──────────────────────────────
APP_URL=https://85-198-48-114.sslip.io
SESSION_MAX_AGE_DAYS=90
SIGNUP_RATE_LIMIT=10
LOG_LEVEL=info

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
AI_MODEL_TEXT=deepseek-flash
AI_MODEL_VISION=deepseek-flash
AI_DAILY_TOKEN_BUDGET=5000000

# Photos land in the MinIO container (S3_* are set in docker-compose.yml: bucket
# `dietyaar`, prefix `prod/`). Flip to true once the photo evaluation passes (runbook),
# then `docker compose up -d app`; no deploy.
PHOTO_LOGGING_ENABLED=false
USDA_LOOKUP_ENABLED=false
USDA_API_KEY=
SCHEDULER_ENABLED=true
STORAGE_SOFT_LIMIT_BYTES=734003200

# ─── Backups: Hamravesh Object Storage (decision 018). Off until the bucket exists. ──
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=
